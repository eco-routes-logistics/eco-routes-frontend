# API Configuration
VITE_API_URL=http://localhost:5000/api/v1
VITE_WS_URL=ws://localhost:5000

# Google Maps (for tracking)
VITE_GOOGLE_MAPS_KEY=your_google_maps_api_key_here

# App Configuration
VITE_APP_NAME=EcoRoutes
VITE_APP_VERSION=1.0.0

# Demo quick-login buttons on the login pages. Leave unset for any public build.
# Must match DEMO_PASSWORD used by the backend's `npm run seed:demo`. Put it in .env.local (git-ignored).
# VITE_DEMO_PASSWORD=
